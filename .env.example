# Browser (exposed to the client bundle; safe by design)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Older projects: VITE_SUPABASE_ANON_KEY=<legacy anon key> also works if no publishable key is set.

# Server-only (never prefix with VITE_; not used by the browser app)
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
